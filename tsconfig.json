{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2022",
    "outDir": "./build",
    "typeRoots": ["./node_modules/@types", "./modules/@types"],
    "declaration": true,
    "sourceMap": true,

    "strict": true,
    "alwaysStrict": true,
    "noImplicitAny": true,

    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
  },
  "include": ["./modules/**/*", "./spec/**/*"],
  "exclude": ["node_modules", "./spec/support/*.json"]
}