    "prepublishOnly": "npm run clean && npx tsc --project tsconfig.publish.json"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.10",
    "colors": "^1.4.0",
    "commander": "^12.1.0",
    "docx": "^8.5.0",
    "dotenv": "^16.4.5",
    "https-proxy-agent": "^7.0.5",
    "open": "^10.1.0",
    "pdfmake": "^0.2.10",
    "prompts": "^2.4.2",
    "xpath": "^0.0.34"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/eslint-parser": "^7.25.1",
    "@eslint/js": ">=9.3.0",
    "@jest/globals": "^29.7.0",
    "@stylistic/eslint-plugin-js": "^2.6.2",
    "@types/eslint": "^9.6.0",
    "@types/eslint__js": "^8.42.3",
    "@types/jest": "^29.5.12",
    "@types/jest-when": "^3.5.5",
    "@types/node": "^22.0.0",
    "@types/prompts": "^2.4.9",
    "eslint": ">=9.3.0",
    "eslint-plugin-jest": "^28.8.0",
    "globals": ">=15.9.0",
    "jest": "^29.7.0",
    "jest-when": "^3.6.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.1.0"
