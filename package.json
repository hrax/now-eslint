{
  "name": "@hrax/now-eslint",
  "version": "1.0.0",
  "description": "NodeJS CLI to ESLint update set changes on Service Now instances",
  "keywords": [
    "service now",
    "servicenow",
    "service",
    "now",
    "snow",
    "eslint",
    "lint",
    "cli",
    "report",
    "reporting",
    "QA"
  ],
  "homepage": "https://github.com/hrax/now-eslint",
  "bugs": "https://github.com/hrax/now-eslint/issues",
  "license": "MIT",
  "author": {
    "name": "Gregor Magdolen",
    "url": "https://hrax.dev"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./generator": "./modules/generator/index.js",
    "./generator/index": "./modules/generator/index.js",
    "./generator/index.js": "./modules/generator/index.js"
  },
  "bin": {
    "now-eslint": "./modules/cli/now-eslint.js"
  },
  "files": [
    "build",
    "resources",
    "index.js",
    "package.json",
    "README.md",
    "LICENSE.txt"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/hrax/now-eslint.git"
  },
  "scripts": {
    "build": "npx tsc",
    "clean": "npx tsc --build --clean",
    "build:clean": "npm run clean && npm run build",
    "test": "npm run build && jasmine"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.10",
    "commander": "^12.1.0",
    "docx": "^8.5.0",
    "dotenv": "^16.4.5",
    "https-proxy-agent": "^7.0.5",
    "pdfmake": "^0.2.10",
    "prompt": "^1.3.0",
    "xpath": "^0.0.34"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/eslint-parser": "^7.25.1",
    "@types/jasmine": "^5.1.4",
    "@types/node": "^22.0.0",
    "eslint": ">=9.3.0",
    "eslint-plugin-jasmine": "^4.2.0",
    "jasmine": "^5.2.0",
    "typescript": "^5.5.4"
  },
  "peerDependencies": {
    "eslint": ">=9.3.0"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  }
}
