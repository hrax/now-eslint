{
  "name": "@hrax/now-eslint",
  "version": "1.0.0",
  "description": "NodeJS CLI to ESLint update set changes on Service Now instances",
  "keywords": [
    "service now",
    "servicenow",
    "service",
    "now",
    "snow",
    "eslint",
    "lint",
    "cli",
    "report",
    "reporting",
    "QA"
  ],
  "homepage": "https://github.com/hrax/now-eslint",
  "bugs": "https://github.com/hrax/now-eslint/issues",
  "license": "MIT",
  "author": {
    "name": "Gregor Magdolen",
    "url": "https://hrax.dev"
  },
  "exports": {
    "./package.json": "./package.json",
    "./generator": "./dist/generator/index.js",
    "./generator/index": "./dist/generator/index.js",
    "./generator/index.js": "./dist/generator/index.js"
  },
  "bin": {
    "now-eslint": "dist/cli/now-eslint.js"
  },
  "files": [
    "dist",
    "package.json",
    "LICENSE.txt"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/hrax/now-eslint.git"
  },
  "scripts": {
